# SFL Shuttle Portal — environment template.
# Copy to `.env.local` for development, and set real values on the server.
# `.env.local` is gitignored; never commit real secrets.

# --- Database (the bot's MySQL, e.g. the docker `mysql_db` service) ----------
# On the EC2 host the portal runs beside the bot, so 127.0.0.1 works.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=shuttle_db

# --- Session -----------------------------------------------------------------
# Signs the login cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-a-32-byte-base64-secret
SESSION_TTL_HOURS=12

# --- Display -----------------------------------------------------------------
APP_TIMEZONE=America/New_York
